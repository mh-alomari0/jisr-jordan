# ============================================================
# Jisr Jordan — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in real values:
#   cp .env.example .env.local
#
# NEVER commit .env.local — it is gitignored automatically.
# ============================================================

# ---- Supabase (required) ----
# Your Supabase project URL (found in Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key (safe to expose client-side)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key (SERVER-SIDE ONLY — bypasses RLS)
# Used by: webhooks, admin notification dispatch, account deletion
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ---- Payments ----
# HMAC secret for payment intent signature generation
# Used by: /api/payments/verify, createPaymentIntentAction
PAYMENT_GATEWAY_SECRET=your-payment-gateway-hmac-secret

# HMAC secret for incoming payment webhook verification
# Must match the secret configured in your payment gateway dashboard
# Used by: /api/webhooks/payment
PAYMENT_WEBHOOK_SECRET=your-payment-webhook-secret

# ---- Application (optional, has fallback) ----
# Public base URL used in robots.txt, sitemap.xml, and meta tags
NEXT_PUBLIC_APP_URL=https://jisr-jordan.com
