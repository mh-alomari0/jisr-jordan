# ============================================================
# Jisr Jordan — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in real values:
#   cp .env.example .env.local
#
# NEVER commit .env.local — it is gitignored automatically.
# ============================================================

# ---- Supabase (required) ----
# Your Supabase project URL (found in Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key (safe to expose client-side)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key (optional; SERVER-SIDE ONLY — bypasses RLS).
# Current marketplace actions do not consume it. Add it only when a reviewed,
# trusted Admin Auth operation (for example account deletion) is implemented.
# SUPABASE_SERVICE_ROLE_KEY=

# ---- Distributed rate limiting (required in production) ----
# Development/test defaults to an in-memory process-local limiter. Production
# fails closed unless a distributed backend is explicitly configured.
RATE_LIMIT_BACKEND=upstash
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Application (required in production) ----
# Exact HTTPS production origin used by Auth callbacks, robots, sitemap, and metadata.
# The documented localhost fallback is development-only; verify this value before deploy.
NEXT_PUBLIC_APP_URL=https://YOUR_DOMAIN

# Optional live E2E accounts. Playwright reads these from .env.local. Create them
# manually in a dedicated non-production Auth project; never commit passwords.
# Leave E2E_BASE_URL empty for the local server, or set the exact deployed QA URL.
E2E_BASE_URL=
# CUSTOMER: Auth user + public.users role CUSTOMER.
# PROVIDER: Auth user + STAFF role + APPROVED/verified provider profile, at least
# one active seeded service, and a schedule covering the assignment test slot.
# ADMIN: Auth user + public.users role ADMIN (SUPER_ADMIN is not required).
E2E_CUSTOMER_EMAIL=
E2E_CUSTOMER_PASSWORD=
E2E_PROVIDER_EMAIL=
E2E_PROVIDER_PASSWORD=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
